{
  "name": "@galactic/server",
  "version": "0.0.1",
  "private": true,
  "description": "GalacticAgents Mission Control server: agent runtime, adapters, brains, SQLite persistence and the WebSocket API.",
  "type": "module",
  "main": "dist/lib.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "dev": "GALACTIC_DEV=1 tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@fastify/static": "^10.1.5",
    "@galactic/protocol": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "http_ece": "1.2.0",
    "tsx": "^4.23.15"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "bin": {
    "galactic": "./bin/galactic.mjs"
  },
  "files": [
    "dist",
    "bin"
  ]
}
