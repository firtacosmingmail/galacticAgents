{
  "name": "@galactic/server",
  "version": "0.0.1",
  "private": true,
  "description": "GalacticAgents Mission Control server: agent runtime, adapters, brains, SQLite persistence and the WebSocket API.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
