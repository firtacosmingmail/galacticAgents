# dependencies and builds (pnpm only: other package managers' lockfiles are never committed)
node_modules/
package-lock.json
yarn.lock
dist/
build/
.turbo/
# the desktop shell's Rust build (P8-06): Cargo's target dir and Tauri's generated schemas
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
*.tsbuildinfo
# Playwright smoke tests' output (P8-05); the baselines under e2e/tests/__screenshots__ are kept
e2e/test-results/
e2e/playwright-report/

# runtime data
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
.galactic/

# secrets and local config
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# JSON reports the rtk vitest wrapper writes next to a package
.vitest/

# Agent worktrees made by Claude Code
.claude/worktrees/

# brainstorming mockups
.superpowers/
