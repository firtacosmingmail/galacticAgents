# dependencies and builds (pnpm only: other package managers' lockfiles are never committed)
node_modules/
package-lock.json
yarn.lock
dist/
build/
.turbo/
*.tsbuildinfo

# runtime data
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
.galactic/

# secrets and local config
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# JSON reports the rtk vitest wrapper writes next to a package
.vitest/
