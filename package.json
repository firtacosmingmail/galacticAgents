{
  "name": "galactic-agents",
  "private": true,
  "version": "0.0.1",
  "description": "Mission Control for the AI coding agents running on your computer, through a solar-system interface.",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build:deps": "pnpm --filter @galactic/protocol --filter @galactic/server build",
    "dev": "pnpm --filter @galactic/protocol build && concurrently -n protocol,server,web -c blue,green,magenta \"pnpm --filter @galactic/protocol dev\" \"pnpm --filter @galactic/server dev\" \"pnpm --filter @galactic/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm build:deps && pnpm -r test",
    "typecheck": "pnpm --filter @galactic/protocol build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node apps/server/bin/galactic.mjs start",
    "galactic": "node apps/server/bin/galactic.mjs",
    "remote": "node scripts/remote-start.mjs",
    "desktop:dev": "pnpm build && pnpm --filter @galactic/desktop dev",
    "desktop:build": "pnpm build && pnpm --filter @galactic/desktop bundle",
    "desktop:smoke": "pnpm build && pnpm --filter @galactic/desktop smoke",
    "check:real": "pnpm build:deps && node scripts/check-real.mjs",
    "drills": "pnpm build:deps && GALACTIC_DRILLS=${GALACTIC_DRILLS:-25} pnpm --filter @galactic/server exec vitest run src/test/drills",
    "e2e": "pnpm build && pnpm --filter @galactic/e2e e2e",
    "e2e:install": "pnpm --filter @galactic/e2e exec playwright install chromium"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
